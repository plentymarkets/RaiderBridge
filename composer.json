{
    "name": "plentymarkets/raiderbridge",
    "description": "Adds the power of Twig to Laravel",
    "keywords": ["laravel", "twig"],
    "license": "MIT",
    "authors": [
        {
            "name": "Rob Crowe",
            "email": "hello@vivalacrowe.com"
        },
        {
            "name": "Barry vd. Heuvel",
            "email": "barryvdh@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "twig/raider": "1.x-dev",
        "illuminate/support": "^12|^13",
        "illuminate/view": "^12|^13"
    },
    "require-dev": {
        "ext-json": "*",
        "laravel/framework": "^12|^13",
        "mockery/mockery": "^1.3.1",
        "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0",
        "squizlabs/php_codesniffer": "^3.6"
    },
    "suggest": {
        "twig/extensions": "~1.0",
        "laravelcollective/html": "For bringing back html/form in Laravel 5.x"
    },
    "autoload": {
        "psr-4": {
            "RaiderBridge\\": "src",
            "TwigBridge\\Tests\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.11-dev"
        },
        "laravel": {
            "providers": [
                "RaiderBridge\\ServiceProvider"
            ],
            "aliases": {
                "Raider": "RaiderBridge\\Facade\\Twig"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
